# Copy to .env and fill in. .env is gitignored; this file is not.

# Anthropic — specialist loops and PDF text extraction via document blocks.
# Required by cmd/chat, cmd/ingest, and brightspace-mcp --expose=specialists.
ANTHROPIC_API_KEY=

# Voyage AI — voyage-4 embeddings for the vector index. Separate provider,
# separate key. 200M free tokens on the voyage-4 family.
VOYAGE_API_KEY=

# Where the content store lives: manifest.json, blobs/, text/, vectors/.
# Defaults to ~/.brightspace-assistant when unset.
BRIGHTSPACE_STORE_DIR=

# Local folder mode (build step 12) — point this at hand-downloaded course
# files to query real material with no API access. Watched by ingest --watch.
BRIGHTSPACE_CONTENT_DIR=

# ---------------------------------------------------------------------------
# D2L Valence
# ---------------------------------------------------------------------------

# Your institution's Brightspace, no trailing slash. Set this and
# brightspace-mcp talks to the tenant instead of the fixtures — so it needs
# credentials alongside it, or startup fails rather than quietly serving mocks.
D2L_HOST=

# Session-cookie auth. The /d2l/api/ routes accept the same cookies the web UI
# uses, which is the one path to real data that needs no admin approval.
#
# Preferred form: a path, re-read before every request. A session that expires
# while the server is running is then fixed by rewriting the file, with no
# restart — which matters over MCP stdio, where restarting the server ends the
# client's session too.
#
# Fill it with the login helper, which opens a browser, waits while you sign in,
# and remembers the profile so later runs usually need no login at all:
#
#   go run ./cmd/d2l-login --host https://brightspace.cuny.edu
#   go run ./cmd/d2l-login --check          # still valid?
#
D2L_COOKIE_FILE=

# The same value inline, if you would rather copy it by hand: log into
# Brightspace, open DevTools → Network, click any request to /d2l/api/, and copy
# the request's Cookie header verbatim — the whole semicolon-separated string,
# not one cookie.
#
#   D2L_COOKIE='d2lSecureSessionVal=...; d2lSessionVal=...'
#
# Fine for a one-off command, wrong for a server: it is captured once at startup.
# D2L_COOKIE_FILE wins when both are set.
#
# Treat either as a password: it is a live session, so anyone holding it is
# logged in as you. Sessions expire in hours, and an expired one comes back as an
# HTML login page rather than a 401 — the client reports that as ErrUnauthorized.
D2L_COOKIE=

# OAuth — unused until an admin registers a client via Manage Extensibility.
# There is no student path to self-registration, so these stay empty for now.
D2L_CLIENT_ID=
D2L_CLIENT_SECRET=
D2L_REDIRECT_URI=http://localhost:8080/callback

# A bearer token obtained by hand, for probing a real tenant before the
# authorization code flow exists. Takes precedence over D2L_COOKIE.
D2L_ACCESS_TOKEN=

# A course id from your own enrollments, used only by the opt-in live probe in
# internal/brightspace to exercise an LE route:
#
#   D2L_HOST=... D2L_COOKIE=... D2L_ORG_UNIT=1234567 \
#     go test ./internal/brightspace/ -run RealTenant -v
D2L_ORG_UNIT=
