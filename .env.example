# Copy to .env and fill in. .env is gitignored; this file is not.

# Anthropic — specialist loops and PDF text extraction via document blocks.
# Required by cmd/chat, cmd/ingest, and brightspace-mcp --expose=specialists.
ANTHROPIC_API_KEY=

# Voyage AI — voyage-4 embeddings for the vector index. Separate provider,
# separate key. 200M free tokens on the voyage-4 family.
VOYAGE_API_KEY=

# Where the content store lives: manifest.json, blobs/, text/, vectors/.
# Defaults to ~/.brightspace-assistant when unset.
BRIGHTSPACE_STORE_DIR=

# Local folder mode (build step 12) — point this at hand-downloaded course
# files to query real material with no API access. Watched by ingest --watch.
BRIGHTSPACE_CONTENT_DIR=

# ---------------------------------------------------------------------------
# D2L Valence — unused until an admin registers an OAuth client. There is no
# student path to self-registration, so these stay empty for now.
# ---------------------------------------------------------------------------
D2L_HOST=
D2L_CLIENT_ID=
D2L_CLIENT_SECRET=
D2L_REDIRECT_URI=http://localhost:8080/callback
